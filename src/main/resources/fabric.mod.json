{
	"schemaVersion": 1,
	"id": "macrotrigger",
	"version": "${version}",
	"name": "MacroTrigger",
	"description": "A Fabric mod that ports and recreates the trigger-based macro system from the 1.12.2 LiteLoader Macro Key Bind Mod",
	"authors": [
		"JesusMRS05"
	],
	"contact": {
		"sources": "https://github.com/JesusMRS05/MacroTriggerFabric"
	},
	"license": "CC0-1.0",
	"icon": "assets/macrotrigger/icon.png",
	"environment": "client",
	"entrypoints": {
		"main": [
			"com.github.jesusmrs05.MacroTrigger"
		],
		"client": [
			"com.github.jesusmrs05.MacroTriggerClient"
		],
		"modmenu": [
			"com.github.jesusmrs05.macrotrigger.compat.ModMenuCompat"
		]
	},
	"mixins": [
		"macrotrigger.mixins.json",
		{
			"config": "macrotrigger.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.18.2",
		"minecraft": "~1.21.11",
		"java": ">=21",
		"fabric-api": "*"
	},
	"suggests": {
		"another-mod": "*"
	}
}